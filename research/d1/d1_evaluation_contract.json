    "local-evidence/d1-model-gate005/d1_model_024_gate005_adjudication.json": "fef41842bbd23a41bcb2f5fe42e4d01b91d6a1ad8e260938df28669f2ed70571",
    "/Volumes/DenarixxSSD/Denarixx-Frontier-AI/D1/d1_storage_policy.json": "7a29cfd7cb1b19a6b0203ccf9a4e02b543f99ca037f958600811337b7688c124"
  },
  "evaluationPurpose": {
    "primary": "Provide an independent, reproducible and contamination-controlled measurement framework for future D1 model evaluation.",
    "evaluationIsMeasurementNotTraining": true,
    "evaluationIsNotCandidateSelectionUnlessSeparatelyAuthorized": true,
    "claimsLimitedToMeasuredScope": true
  },
  "independencePolicy": {
    "trainingAndFormalEvaluationDataMustRemainLogicallySeparated": true,
    "formalEvaluationDataMayNotBeUsedForTraining": true,
    "formalEvaluationDataMayNotBeUsedForThresholdTuning": true,
    "formalEvaluationDataMayNotBeUsedForCandidateSelection": true,
    "benchmarkAnswerInjectionForScoreInflationProhibited": true,
    "evaluationContaminationChecksRequiredBeforeModelEvaluation": true,
    "evaluationResultsMayNotRetroactivelyAlterEvaluatedTrainingRun": true
  },
  "formalEvaluationDatasetBoundary": {
    "formalDatasetExistsByThisContract": false,
    "formalDatasetConstructionAuthorizedByThisContract": false,
    "formalDatasetAccessAuthorizedByThisContract": false,
    "formalDatasetParsingAuthorizedByThisContract": false,
    "formalDatasetScoringAuthorizedByThisContract": false,
    "formalDatasetTrainingUseAuthorized": false,
    "futureDatasetRequiresSeparateGovernance": true,
    "futureDatasetMustBeIndependentlyVersionedAndHashed": true,
    "futureDatasetMustHaveProvenance": true,
    "futureDatasetMustPassContaminationControls": true
  },
  "modelIdentityPolicy": {
    "evaluationRequiresExactModelIdentity": true,
    "evaluationRequiresModelArtifactSha256": true,
    "evaluationRequiresArchitectureIdentity": true,
    "modelIdentityNotYetBoundBecauseD1WeightsDoNotYetExist": true,
    "evaluationMustNotSilentlySubstituteAnotherCheckpoint": true
  },
  "tokenizerIdentityPolicy": {
    "evaluationRequiresExactTokenizerIdentity": true,
    "evaluationRequiresTokenizerArtifactSha256": true,
    "tokenizerModificationForEvaluationProhibited": true,
    "sealedD1TokenizerMustRemainUnmodified": true,
    "d0TokenizerMustRemainUnmodified": true
  },
  "futureProtocolRequirements": {
    "separateEvaluationProtocolRequiredBeforeFormalEvaluation": true,
    "protocolMustFreezeBeforeFormalDatasetExposureOrScoring": true,
    "protocolMustDefine": [
      "evaluation objectives",
      "evaluated capability families or task domains",
      "dataset construction and provenance rules",
      "dataset size and schema",
      "tokenizer compatibility requirements",
      "context-length compatibility requirements",
      "evaluation metrics",
      "metric aggregation rules",
      "generation and scoring determinism",
      "evaluator identity requirements",
      "evidence persistence requirements",
      "failure behavior",
      "repeatability or one-time execution semantics",
      "completion and adjudication semantics",
      "claim boundaries"
    ],
    "metricThresholdsMustNotBeChosenAfterObservingFormalResults": true,
    "datasetContentMustNotBeSelectedUsingFormalModelPerformance": true
  },
  "metricGovernance": {
    "metricsDefinedByThisContract": false,
    "metricThresholdsDefinedByThisContract": false,
    "reason": "Exact D1 evaluation metrics and any thresholds belong to the future frozen evaluation protocol and must be selected before formal results are observed."
  },
  "baselineComparatorPolicy": {
    "comparatorRequiredByThisContract": false,
    "futureComparatorUseRequiresProtocolDefinition": true,
    "d0MustNotBeReopenedOrModifiedToCreateComparatorEvidence": true
  },
  "reproducibilityRequirements": {
    "evaluatedModelIdentityMustBeHashed": true,
    "tokenizerIdentityMustBeHashed": true,
    "formalDatasetIdentityMustBeHashed": true,
    "evaluationProtocolIdentityMustBeHashed": true,
    "evaluatorIdentityMustBeHashed": true,
    "rawResultArtifactMustBeHashed": true,
    "executionConfigurationMustBePersisted": true,
    "deterministicScoringRequiredWhereDefinedByProtocol": true
  },
  "evidenceRequirements": {
    "futureExecutionEvidenceMustPreserve": [
      "evaluation contract identity",
      "evaluation protocol identity",
      "model/checkpoint identity",
      "tokenizer identity",
      "formal dataset identity",
      "evaluator identity",
      "execution configuration",
      "aggregate metrics",
      "required scoped metrics",
      "execution status",
      "adjudication result"
    ],
    "existingEvidenceMustNotBeSilentlyOverwritten": true
  },
  "storagePolicy": {
    "storageContract": "D1-STOR-002",
    "evaluationArtifactRoot": "/Volumes/DenarixxSSD/Denarixx-Frontier-AI/D1/evaluation",
    "formalEvaluationArtifactsMustFollowStorageContract": true
  },
  "failurePolicy": {
    "failClosedOnIdentityMismatch": true,
    "failClosedOnDatasetIntegrityFailure": true,
    "failClosedOnTokenizerCompatibilityFailure": true,
    "failClosedOnContextCompatibilityFailure": true,
    "failClosedOnIncompleteRequiredMetrics": true,
    "failClosedOnGovernanceViolation": true,
    "failureEvidenceMustNotBeRewrittenAsSuccess": true
  },
  "d0Isolation": {
    "d0ModificationAuthorized": false,
    "d0CheckpointModificationAuthorized": false,
    "d0TokenizerModificationAuthorized": false,
    "historicalD0FormalDatasetReuseAuthorized": false,
    "d0EvaluationRerunAuthorized": false
  },
  "authorizationBoundary": {
    "evaluationContractCreationAuthorized": true,
    "evaluationProtocolDesignAuthorizedAfterContractFreeze": true,
    "formalEvaluationDatasetConstructionAuthorized": false,
    "formalEvaluationDatasetAccessAuthorized": false,
    "formalEvaluationExecutionAuthorized": false,
    "d1TrainingAuthorized": false,
    "d1WeightsCreationAuthorized": false,
    "d1CheckpointCreationAuthorized": false,
    "tokenizerModificationAuthorized": false,
    "tokenizerTrainingAuthorized": false,
    "additionalTrainingCorpusAcquisitionAuthorized": false,
    "additionalTrainingCorpusConstructionAuthorized": false,
    "d0ModificationAuthorized": false
  },
  "gateSemantics": {
    "contractExistenceCanSatisfyGate006Requirement": true,
    "gate006PassDoesNotByItselfAuthorizeTraining": true,
    "gate006PassDoesNotAuthorizeWeightCreation": true,
    "gate006PassDoesNotAuthorizeCheckpointCreation": true,
    "gate006PassDoesNotAuthorizeFormalEvaluation": true,
    "gate006PassDoesNotAuthorizeFormalDatasetAccess": true,
    "separateTrainingAuthorizationRequiredAfterReadinessAdjudication": true
  },
  "currentState": {
    "d1TrainingStarted": false,
    "d1WeightsExist": false,
    "d1CheckpointExists": false,
    "formalD1EvaluationDatasetConstructed": false,
