  },
  "gateBinding": {
    "gate": "D1-GATE-006",
    "requirement": "D1 evaluation contract must exist before full training begins.",
    "predecessorGate": "D1-GATE-005"
  },
  "authoritativeInputs": {
    "research/d1/d1_architecture_contract.json": "93bb003b16fb13efb07f8a724d6371f067b480df61842f4808f2cb03557ff778",
    "research/d1/d1_data_acquisition_contract.json": "61f0db2623c8fbc016364394a367a6de9b66aceee3820b40fb16a2461bd61913",
    "research/d1/d1_tokenizer_contract.json": "c5c3c2f628b7ccbeafee047985f1139bbbc88f67e1751396722141b5e751d64c",
